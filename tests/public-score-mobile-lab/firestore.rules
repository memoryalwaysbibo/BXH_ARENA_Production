rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // DEMO EMULATOR ONLY. Unauthenticated readers may access public lab projections.
  function visible(room) { return get(/databases/$(database)/documents/labRooms/$(room)).data.visibility == 'public'; }
  match /labRooms/{room} { allow read: if resource.data.visibility == 'public'; allow write: if false; }
  match /labRooms/{room}/public/{id} { allow read: if visible(room); allow write: if false; }
  match /labRooms/{room}/deltas/{id} { allow read: if visible(room); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
