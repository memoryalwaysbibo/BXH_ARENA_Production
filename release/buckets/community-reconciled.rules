// BXH ARENA Firestore Rules v13.40.10
// 2026-10-06: add atomic +8 roster contract; preserve deployed legacy writes, assignment scope and lifecycle locks.
// 2026-09-28: align public tournament mirror schema with battleMode/teamSize/playMode emitted by Production frontend.
// Production RC1 2026-09-19: self-service account creation is player-only/password-only; email must match Auth token; tester remains super_admin-managed sandbox; bootstrap can only be sealed by the newly-created active super_admin.
// 2026-09-17: atomic community-room deletion authorizes its public mirror by immutable owner fields.
// 2026-09-16: redeploy current Beta rules for player community-room creation.
// 2026-09-15: tester management is restricted to the actor's own TEST tournament.
// 2026-09-12: server-only closure, restore, raffle and activity paths.
// 2026-09-11: Blaze deployment stabilization release. Permission scope is
// unchanged from v13.29.0; trusted title/check-in writes remain server-only.
// 2026-09-11: add isolated title/daily-check-in read paths. All awards,
// check-ins, statistics and audit writes are server-only through Cloud Functions.
// 2026-09-11: add isolated tester role, test-only tournament ownership and
// fixed seven-day expiry invariants. Testers cannot write official or ladder data.
// 2026-09-11: v13.28.4 tester sandbox security release, based on the
// v13.28.3 bracket display update.
// 2026-09-11: v13.28.2 atomic referee-assignment Transaction and dual
// server read-back verification. Permission scope unchanged from v13.28.1.
// 2026-09-11: add Court referee assignment metadata protection + safe staffDirectory.
// 2026-09-10: allow active staff to create/publish an official tournament only when
// the private tournament is created by that same staff UID and initially assigned
// exclusively to that UID. Existing-event assignment, delete, role management and
// ladder settlement privileges are NOT broadened.
// v13.19.2：新增 ladderSkippedPlayers；測試／未綁定現場玩家可略過正式天梯，但該略過名單與結算結果同樣受不可覆寫保護。
rules_version = '2';
// v13.19.2 天梯新增：ladderPlayers / ladderSystem / ladderSeasons / ladderTransactions。
// 積分賽事結算的 tournaments ladder* 欄位僅 admin/super_admin 可正式寫入；staff 被明確禁止。
// 新賽季切換僅 super_admin 可更新 ladderSystem 與既有 ladderSeasons。
// ============================================================================
// BXH ARENA — Firestore Security Rules v13.19.2（含天梯系統）
//
// v13.29.8 已於 Firestore Emulator 驗證關閉／恢復保護與角色案例。
// 測試範圍詳見 RELEASE_v13.29.8.md，並非所有歷史規則的完整驗證。
//
// v10 相對 v9 的關鍵變更：
//   1. 移除 users/{uid}/registrationRefs/{code} 獨立文件，改用
//      collectionGroup('registrations') 查詢玩家自己的報名記錄
//      —— 這是為了讓「registration 變動時必須同時證明 tournaments／
//      publicTournaments 也正確變動」這個雙向一致性要求，能落在
//      access-call 預算內，不需要犧牲任何一致性檢查。
//   2. registrations 的 create/update 規則現在雙向驗證：不只驗證自己，
//      還驗證 tournaments/publicTournaments 在同一次交易中確實正確同步
//      變動（getAfter 比對），防止「單獨建立/修改 registration、不動
//      counter」的漏洞。
//   3. users/{uid} 的自我更新分支改為明確欄位白名單，玩家無法再透過
//      修改自己的文件把 role/active 改成任意值。
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /onlinePresence/{uid} { allow read, write: if false; }
    match /playerPrivacy/{uid} { allow read, write: if false; }
    match /playerDirectory/{uid} { allow read, write: if false; }


    // QR check-in candidate: unchanged original role predicates still apply.
    function qrCheckinManagedWriteValid(code) {
      let before = get(tourPath(code)).data;
      let after = getAfter(tourPath(code)).data;
      let pubBefore = get(pubPath(code)).data;
      let pubAfter = getAfter(pubPath(code)).data;
      return after.qrCheckinManaged == true
        && !after.diff(before).affectedKeys().hasAny(['qrCheckin'])
        && before.qrCheckinRevision is int
        && after.qrCheckinRevision == before.qrCheckinRevision + 1
        && after.data.matches('.*"qrCheckinRevision":' + string(after.qrCheckinRevision) + '[,}].*')
        && pubAfter.qrCheckinManaged == true
        && pubAfter.qrCheckinRevision == after.qrCheckinRevision
        && pubBefore.qrCheckinRevision == before.qrCheckinRevision;
    }
    function qrCheckinWriteValid(code) {
      return resource.data.get('qrCheckinManaged', false) == true
        ? qrCheckinManagedWriteValid(code)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['qrCheckin','qrCheckinManaged','qrCheckinRevision']);
    }


    // Read-only bucket access follows existing official staff private-room access.
    // Seats control scoring; they do not remove staff read access.
    function scoreBucketReadable(code, id) {
      let room = get(tourPath(code)).data;
      let storage = room.get('scoreStorage', {});
      let config = get(/databases/$(database)/documents/systemConfig/fourCourtScoreBuckets).data;
      return isStaffOrAbove()
        && room.get('eventAuthority', '') == 'official'
        && room.get('createdByRole', '') != 'partner_organizer'
        && config.get('privateReadsEnabled', false) == true
        && storage.get('schema', '') == 'bxh-match-buckets-v1'
        && storage.get('status', '') == 'active'
        && storage.get('code', '') == code
        && storage.get('epoch', '') is string && storage.get('epoch', '').size() > 0
        && storage.get('roomId', '') is string && storage.get('roomId', '').size() > 0
        && id.matches('court-[1-9][0-9]*')
        && resource.data.get('schema', '') == storage.schema
        && resource.data.get('code', '') == code
        && resource.data.get('roomId', '') == storage.roomId
        && resource.data.get('epoch', '') == storage.epoch
        && resource.data.get('bucketId', '') == id
        && resource.data.get('revision', -1) is int && resource.data.get('revision', -1) >= 0
        && resource.data.get('matches', null) is string;
    }
    // General-room referees receive private read access only while seated.
    function communityRefereeReadable(room) {
      let actor = get(userPath(request.auth.uid)).data;
      let release = get(/databases/$(database)/documents/systemConfig/refereeSeatsV1).data;
      return release.get('enabled', false) == true
        && release.get('communitySeatsEnabled', false) == true
        && release.get('perCourtScoringVerified', false) == true
        && room.get('eventAuthority', '') == 'community'
        && room.get('ladderMode', '') == 'general'
        && room.get('refereeSeatsV1', {}).get('version', 0) == 1
        && actor.get('role', '') == 'player' && actor.get('active', false) == true
        && actor.get('isTestAccount', false) != true && actor.get('deleted', false) != true
        && !(actor.get('accountStatus', '') in ['deleted','disabled','frozen'])
        && request.auth.uid in room.get('refereeStationUids', []);
    }

    // Seat ownership / request changes are callable-only, including administrator changes.
    function refereeSeatWriteValid(code, privateDoc) {
      let room = get(tourPath(code)).data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let enabled = room.get('refereeSeatsV1', {}).get('version', 0) == 1;
      return !changed.hasAny(['refereeSeatsV1','refereeSeatNames','bucketMigration'])
        && (!enabled || !privateDoc || !changed.hasAny(['refereeStationAssignments','refereeStationNames','refereeStationUids','refereeStationRestrictionEnabled']))
        && (!enabled || !privateDoc || !changed.hasAny(['data'])
          || isCommunityOwnerData(room) || isAdminOrAbove() || isStaffOfficialCreatorExistingData(room))
        && (!enabled || privateDoc || !changed.hasAny(['bracketView'])
          || isCommunityOwnerData(room) || isAdminOrAbove() || isStaffOfficialCreatorExistingData(room));
    }

    // ==== 路徑輔助函式 ====
    function tourPath(code) { return /databases/$(database)/documents/tournaments/$(code); }
    function pubPath(code) { return /databases/$(database)/documents/publicTournaments/$(code); }
    function regPath(code, uid) { return /databases/$(database)/documents/tournaments/$(code)/registrations/$(uid); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }

    // ==== 純資料角色判斷（不含 get()）====
    function callWriteValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['callRevision'])
        && (resource.data.get('callRevision',0)==0
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['data'])
          || request.resource.data.data.matches('.*"callRevision":'+string(resource.data.callRevision)+'[,}].*'));
    }
    function callMirrorValid(code) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['callRevision'])
        && (getAfter(tourPath(code)).data.get('callRevision',0)==0
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bracketView'])
          || request.resource.data.bracketView.matches('.*"callRevision":'+string(getAfter(tourPath(code)).data.callRevision)+'[,}].*'));
    }
    // Once a court lifecycle operation is used, every browser write to the
    // serialized bracket must advance this dedicated counter. Older tabs do
    // not know this field and are denied after the first exit/resize.
    function courtLifecycleWriteValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let beforeEpoch = resource.data.get('courtLifecycleEpoch', 0);
      let afterEpoch = request.resource.data.get('courtLifecycleEpoch', 0);
      let beforeSeq = resource.data.get('courtLifecycleWriteSeq', 0);
      let afterSeq = request.resource.data.get('courtLifecycleWriteSeq', 0);
      return (beforeEpoch == 0
          && afterEpoch == 0
          && !changed.hasAny(['courtLifecycleEpoch','courtLifecycleWriteSeq']))
        || (beforeEpoch == 0
          && afterEpoch == 1 && beforeSeq == 0 && afterSeq == 1
          && changed.hasAny(['data'])
          && request.resource.data.data.matches('.*"courtLifecycleEpoch":1[,}].*')
          && (request.resource.data.data.matches('.*"forcedCourtExits":.*')
            || request.resource.data.data.matches('.*"courtRetirementPlan":.*')))
        || (beforeEpoch == 1 && afterEpoch == 1
          && (!changed.hasAny(['data','courtLifecycleWriteSeq'])
            || (changed.hasAny(['data']) && afterSeq == beforeSeq + 1
              && request.resource.data.data.matches('.*"courtLifecycleEpoch":1[,}].*'))));
    }
    function courtLifecycleMirrorValid(code) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let before = get(tourPath(code)).data;
      let after = getAfter(tourPath(code)).data;
      return before.get('courtLifecycleEpoch', 0) == 0
        && after.get('courtLifecycleEpoch', 0) == 0
        || !changed.hasAny(['bracketView'])
        || (after.get('courtLifecycleEpoch', 0) == 1
          && after.get('courtLifecycleWriteSeq', 0) == before.get('courtLifecycleWriteSeq', 0) + 1
          && request.resource.data.bracketView.matches('.*"courtLifecycleEpoch":1[,}].*'));
    }
    function entrySelectionWriteValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entrySelectionRevision'])
        && (resource.data.get('entrySelectionRevision', 0) == 0
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['data'])
          || (request.resource.data.get('entrySelectionWriteRevision', 0) == resource.data.entrySelectionRevision
            && request.resource.data.data.matches('.*"entrySelectionRevision":' + string(resource.data.entrySelectionRevision) + '[,}].*')));
    }
    function preservesTestSource() {
      return resource.data.get('testMode', false) != true ||
        (request.resource.data.testMode == true && request.resource.data.eventAuthority == 'test'
        && request.resource.data.ladderMode == 'general'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['testMode','testLabel','createdBy','createdByRole','ownerUid','testCreatedAt','testExpiresAt','expiresAt']));
    }
    function hasTestIdentity(d) { return d.role == 'tester' || d.get('isTestAccount', false) == true; }
    function isAdminData(actorData) {
      return actorData.active == true && !hasTestIdentity(actorData) && (actorData.role == 'super_admin' || actorData.role == 'admin');
    }
    function isStaffOrAboveData(actorData) {
      return actorData.active == true && !hasTestIdentity(actorData) && (actorData.role == 'super_admin' || actorData.role == 'admin' || actorData.role == 'staff');
    }
    function isTesterData(actorData) {
      return actorData.active == true && hasTestIdentity(actorData);
    }
    function isTesterOwnedTestData(actorData, tournamentData) {
      return isTesterData(actorData)
        && tournamentData.testMode == true
        && tournamentData.testLabel == '（測試）'
        && tournamentData.eventAuthority == 'test'
        && tournamentData.createdBy == request.auth.uid
        && tournamentData.ownerUid == request.auth.uid
        && tournamentData.createdByRole == 'tester'
        && tournamentData.ladderMode == 'general'
        && tournamentData.ladderPointsAwarded != true;
    }
    function validTesterTestCreate(d) {
      return isSignedIn()
        && isTesterData(myProfile())
        && isTesterOwnedTestData(myProfile(), d)
        && d.expiresAt is timestamp
        && d.testExpiresAt is timestamp
        && d.expiresAt == d.testExpiresAt
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(7, 'd') + duration.value(5, 'm')
        && d.assignedStaffUids is list
        && (d.assignedStaffUids.size() == 0 || (d.assignedStaffUids.size() == 1 && request.auth.uid in d.assignedStaffUids));
    }
    function isActivePartnerData(actorData) {
      return actorData.active == true
        && !hasTestIdentity(actorData)
        && actorData.role == 'player'
        && ('partnerOrganizer' in actorData)
        && actorData.partnerOrganizer is map
        && actorData.partnerOrganizer.get('status','') == 'active'
        && actorData.partnerOrganizer.get('organizationId','') is string
        && actorData.partnerOrganizer.get('organizationId','').size() > 0
        && (actorData.partnerOrganizer.get('startsAtMs',0) == 0
          || actorData.partnerOrganizer.get('startsAtMs',0) <= request.time.toMillis())
        && (
          (actorData.partnerOrganizer.get('expiresAtMs',0) is number
            && actorData.partnerOrganizer.get('expiresAtMs',0) > request.time.toMillis())
          || (actorData.partnerOrganizer.get('expiresAt',0) is number
            && actorData.partnerOrganizer.get('expiresAt',0) > request.time.toMillis())
        );
    }
    function isManualPartnerGrantData(actorData) {
      return actorData.partnerOrganizer.get('scope','manual') != 'contract'
        && actorData.partnerOrganizer.get('orderCode','') == ''
        && actorData.get('partnerContractOrderCode','') == '';
    }
    function partnerOrderCodeMatches(actorData, tournamentData) {
      let actorOrderCode = actorData.partnerOrganizer.get('orderCode', actorData.get('partnerContractOrderCode',''));
      return (actorOrderCode is string
          && actorOrderCode.size() > 0
          && tournamentData.get('partnerContractOrderCode','') == actorOrderCode)
        || (isManualPartnerGrantData(actorData)
          && tournamentData.get('partnerContractOrderCode', null) == null);
    }
    function isPartnerTournamentData(actorData, tournamentData) {
      return isActivePartnerData(actorData)
        && tournamentData.get('eventAuthority','') == 'official'
        && tournamentData.get('createdBy','') == request.auth.uid
        && tournamentData.get('createdByRole','') == 'partner_organizer'
        && tournamentData.get('partnerOrganizationCode','') == actorData.partnerOrganizer.organizationId
        && partnerOrderCodeMatches(actorData, tournamentData);
    }
    function paidPartnerQuotaValid(code, orderCode) {
      let contractPath = /databases/$(database)/documents/partnerContracts/$(orderCode);
      return exists(contractPath)
          && get(contractPath).data.status == 'active'
          && get(contractPath).data.targetUid == request.auth.uid
          && get(contractPath).data.get('usedEvents', -1) is int
          && get(contractPath).data.get('includedEvents', 0) is int
          && getAfter(contractPath).data.usedEvents == get(contractPath).data.usedEvents + 1
          && getAfter(contractPath).data.lastRoomCode == code
          && getAfter(contractPath).data.usedEvents <= get(contractPath).data.includedEvents;
    }
    function partnerQuotaValidForCreate(code, tournamentData) {
      return tournamentData.get('createdByRole', '') != 'partner_organizer'
        || tournamentData.get('partnerContractOrderCode', null) == null
        || paidPartnerQuotaValid(code, tournamentData.partnerContractOrderCode);
    }
    function isActivePartnerOwnerData(ownerData, ownerUid, tournamentData) {
      return isActivePartnerData(ownerData)
        && tournamentData.get('eventAuthority','') == 'official'
        && tournamentData.get('createdBy','') == ownerUid
        && tournamentData.get('createdByRole','') == 'partner_organizer'
        && tournamentData.get('partnerOrganizationCode','') == ownerData.partnerOrganizer.organizationId
        && (((ownerData.partnerOrganizer.get('orderCode', ownerData.get('partnerContractOrderCode','')) is string)
              && ownerData.partnerOrganizer.get('orderCode', ownerData.get('partnerContractOrderCode','')).size() > 0
              && tournamentData.get('partnerContractOrderCode','') == ownerData.partnerOrganizer.get('orderCode', ownerData.get('partnerContractOrderCode','')))
          || (isManualPartnerGrantData(ownerData)
              && tournamentData.get('partnerContractOrderCode', null) == null));
    }
    function isActiveEventStaffData(actorData, tournamentData) {
      let ownerUid = tournamentData.get('createdBy','');
      let ownerData = get(userPath(ownerUid)).data;
      let assignments = tournamentData.get('eventStaffAssignments', {});
      let assignment = request.auth.uid in assignments ? assignments[request.auth.uid] : {};
      return actorData.active == true
        && !hasTestIdentity(actorData)
        && assignments is map
        && request.auth.uid in assignments
        && assignment is map
        && assignment.get('status','') == 'accepted'
        && assignment.get('targetUid','') == request.auth.uid
        && assignment.get('organizerUid','') == ownerUid
        && assignment.get('organizationId','') == tournamentData.get('partnerOrganizationCode','')
        && isActivePartnerOwnerData(ownerData, ownerUid, tournamentData)
        && assignment.get('parentExpiresAtMs',0) == ownerData.partnerOrganizer.get('expiresAtMs', ownerData.partnerOrganizer.get('expiresAt',0))
        && (((ownerData.partnerOrganizer.get('orderCode', ownerData.get('partnerContractOrderCode','')) is string)
              && ownerData.partnerOrganizer.get('orderCode', ownerData.get('partnerContractOrderCode','')).size() > 0
              && assignment.get('parentOrderCode','') == ownerData.partnerOrganizer.get('orderCode', ownerData.get('partnerContractOrderCode','')))
          || (isManualPartnerGrantData(ownerData) && assignment.get('parentOrderCode', null) == null))
        ;
    }
    function isAssignedStaffData(actorData, tournamentData) {
      return (actorData.active == true && !hasTestIdentity(actorData) && actorData.role == 'staff' &&
        (!('assignedStaffUids' in tournamentData) || tournamentData.assignedStaffUids.size() == 0
         || request.auth.uid in tournamentData.assignedStaffUids))
        || isPartnerTournamentData(actorData, tournamentData)
        || isActiveEventStaffData(actorData, tournamentData);
    }
    function canManageTournamentData(actorData, tournamentData) {
      return isAdminData(actorData) || isTesterOwnedTestData(actorData, tournamentData) || isAssignedStaffData(actorData, tournamentData);
    }
    function isCommunityOwnerData(tournamentData) {
      return request.auth != null
        && tournamentData.eventAuthority == 'community'
        && tournamentData.createdBy == request.auth.uid
        && tournamentData.ownerUid == request.auth.uid;
    }
    function validCommunityInvariant(d) {
      return d.eventAuthority == 'community'
        && d.createdBy == request.auth.uid
        && d.ownerUid == request.auth.uid
        && d.createdByRole == 'player'
        && d.ladderMode == 'general'
        && d.registrationEnabled is bool
        && d.ladderPointsAwarded != true;
    }
    function isStaffOfficialCreatorData(d) {
      return isSignedIn()
        && (
          (myProfile().active == true
            && !hasTestIdentity(myProfile()) && myProfile().role == 'staff'
            && d.eventAuthority == 'official'
            && d.createdBy == request.auth.uid)
          || isPartnerTournamentData(myProfile(), d)
        )
        && d.visibility == 'public'
        && ('assignedStaffUids' in d)
        && d.assignedStaffUids.size() == 1
        && request.auth.uid in d.assignedStaffUids
        && d.ladderPointsAwarded != true;
    }

    function isStaffOfficialCreatorExistingData(d) {
      return isSignedIn()
        && ((myProfile().active == true
          && !hasTestIdentity(myProfile()) && myProfile().role == 'staff'
          && d.eventAuthority == 'official'
          && d.createdBy == request.auth.uid)
          || isPartnerTournamentData(myProfile(), d));
    }
    function validRefereeStationConfig(d) {
      return (!('refereeStationAssignments' in d) || d.refereeStationAssignments is map)
        && (!('refereeStationNames' in d) || d.refereeStationNames is map)
        && (!('refereeStationUids' in d) || d.refereeStationUids is list)
        && (!('refereeStationRestrictionEnabled' in d) || d.refereeStationRestrictionEnabled is bool)
        && (!('assignedStaffUids' in d) || d.assignedStaffUids is list)
        && (!('refereeStationUids' in d) || !('assignedStaffUids' in d) || d.assignedStaffUids.hasAll(d.refereeStationUids));
    }

    // ==== 既有角色 helper（維持 v13.12.3 慣例，供 users/{uid} 等既有區塊使用）====
    function isSignedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isSuperAdminData(actorData) { return actorData.active == true && !hasTestIdentity(actorData) && actorData.role == 'super_admin'; }
    function isSuperAdmin() { return isSignedIn() && isSuperAdminData(myProfile()); }
    function isTester() { return isSignedIn() && isTesterData(myProfile()); }
    // Tester writes must use the explicit owned-TEST branch, never the admin branch.
    function isTournamentAdminEquivalent() { return isAdminOrAbove(); }
    function isAdminOrAbove() {
      return isSignedIn() && isAdminData(myProfile());
    }
    function isStaffOrAbove() {
      return isSignedIn() && isStaffOrAboveData(myProfile());
    }
    function isAssignedStaff(tdata) {
      return isSignedIn() && isAssignedStaffData(myProfile(), tdata);
    }
    function canManageTournament(tdata) {
      return isTournamentAdminEquivalent() || isAssignedStaff(tdata)
        || (isTester() && isTesterOwnedTestData(myProfile(), tdata));
    }
    function tournamentExistsFor(code) { return exists(tourPath(code)); }
    function tournamentDataFor(code) { return get(tourPath(code)).data; }
    // v13.24.2: atomic community room creation writes tournaments + publicTournaments
    // in the same WriteBatch. publicTournaments create must validate the post-write
    // state, not the pre-write database state.
    function tournamentExistsAfterFor(code) { return existsAfter(tourPath(code)); }
    function tournamentDataAfterFor(code) { return getAfter(tourPath(code)).data; }

    // ==== BXH 天梯 helper ====
    function validLadderTier(points, tier) {
      return (points >= 300 && tier == '傳奇')
        || (points >= 220 && points < 300 && tier == '大師')
        || (points >= 150 && points < 220 && tier == '菁英')
        || (points >= 100 && points < 150 && tier == '鑽石')
        || (points >= 60 && points < 100 && tier == '白金')
        || (points >= 30 && points < 60 && tier == '黃金')
        || (points >= 10 && points < 30 && tier == '白銀')
        || (points >= 0 && points < 10 && tier == '黑鐵');
    }

    // ==== 每個 READ 路徑各自專用的授權 helper ====
    function canReadTournamentPrivate(tournamentData) {
      let actorData = get(userPath(request.auth.uid)).data;
      return isStaffOrAboveData(actorData) || isTesterData(actorData) || isPartnerTournamentData(actorData, tournamentData)
        || isActiveEventStaffData(actorData, tournamentData);
    }
    function canReadPublicAsStaff() {
      let actorData = get(userPath(request.auth.uid)).data;
      return isStaffOrAboveData(actorData) || isTesterData(actorData);
    }
    function canManageRegistrationRead(code) {
      let actorData = get(userPath(request.auth.uid)).data;
      let tournamentData = get(tourPath(code)).data;
      return canManageTournamentData(actorData, tournamentData)
        || (isSignedIn() && isCommunityOwnerData(tournamentData));
    }

    function userDataFor(uid) { return get(userPath(uid)).data; }

    // ==== registration 建立/異動規則（v10：雙向一致性）====
    function registrationCreateValid(code, uid) {
      let userData = userDataFor(uid);
      let tournamentData = get(tourPath(code)).data;
      let tourAfterData = getAfter(tourPath(code)).data;
