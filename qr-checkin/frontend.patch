+  assert.equal(JSON.parse(h.docs.get('tournaments/LOCAL').data).players[0].checkedIn,true);
+  assert.equal(JSON.parse(h.docs.get('publicTournaments/LOCAL').bracketView).players[0].checkedIn,true);
